[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/template/basic_hud.gd" id="1_basic_hud"]

[node name="BasicHud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_basic_hud")

[node name="TopMargin" type="MarginContainer" parent="."]
