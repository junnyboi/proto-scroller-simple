{
  "schema_version": 1,
  "baseline_revision": "f8b86d9b9497d2c807c68c311b2363c16e26c6dc",
  "default_policy": "retain_until_exercised",
  "purpose": "Resource families that cannot be removed safely from literal-reference evidence alone.",
  "families": [
    {
      "id": "enemy_profile_textures",
      "mechanism": "Resource/profile fields passed to load() by encounter_runtime.gd and procedural_enemy.gd",
      "consumers": [
        "game/scripts/encounter/encounter_runtime.gd",
        "game/scripts/actors/procedural_enemy.gd"
      ],
      "path_patterns": [
        "game/art/city/enemies/archetypes/*",
        "game/art/city/enemies/deployment/*",
        "game/art/city/enemies/effects/*"
      ],
      "phase": "2-9",
      "disposition": "retain_until_compact_enemy_manifest_and_export_are_proven"
    },
    {
      "id": "structural_variant_textures",
      "mechanism": "StructuralBuildingVariant texture_path passed to load()",
      "consumers": [
        "game/scripts/destruction/structural_building_variant.gd",
        "game/scripts/world/streamed_destructible_runtime.gd"
      ],
      "path_patterns": [
        "game/art/city/buildings/**/*",
        "game/art/city/destructibles/**/*",
        "game/resources/**/*facade*"
      ],
      "phase": "2-9",
      "disposition": "retain_until_compact_destructible_and_archive_slice_pass"
    },
    {
      "id": "hazard_visuals_and_audio",
      "mechanism": "Hazard profile texture and stream fields passed to load()",
      "consumers": [
        "game/scripts/hazards/environmental_hazard_2d.gd",
        "game/scripts/hazards/hazard_audio_pool.gd"
      ],
      "path_patterns": [
        "game/art/city/hazards/**/*",
        "game/audio/sfx/hazards/**/*",
        "game/resources/hazards/**/*"
      ],
      "phase": "9",
      "disposition": "archive_with_hazard_runtime_after_template_vfx_audio_pass"
    },
    {
      "id": "dossier_resources",
      "mechanism": "Catalog paths loaded dynamically by dossier_catalog.gd",
      "consumers": [
        "game/scripts/narrative/dossier_catalog.gd"
      ],
      "path_patterns": [
        "game/resources/narrative/dossiers/**/*",
        "game/art/ui/dossier/**/*"
      ],
      "phase": "9",
      "disposition": "archive_with_project_choir_slice"
    },
    {
      "id": "localization_catalogs_and_fonts",
      "mechanism": "Locale-dependent catalog and font selection",
      "consumers": [
        "game/scripts/localization/l10n.gd",
        "game/project.godot"
      ],
      "path_patterns": [
        "game/localization/*.json",
        "game/fonts/**/*"
      ],
      "phase": "4-9",
      "disposition": "retain_until_template_locale_decision_and_landscape_portrait_smoke"
    },
    {
      "id": "title_web_payload",
      "mechanism": "Host DOM sources and runtime-selected orientation payloads",
      "consumers": [
        "client/src/main.ts",
        "client/src/index.css"
      ],
      "path_patterns": [
        "client/public/title-video/*"
      ],
      "phase": "3",
      "disposition": "retain_posters_remove_video_only_after_poster_host_pass"
    },
    {
      "id": "godot_web_payload",
      "mechanism": "Host-selected local or remote engine/WASM/PCK URLs",
      "consumers": [
        "client/src/main.ts",
        "client/public/game/game-manifest.json"
      ],
      "path_patterns": [
        "client/public/game/game.html",
        "client/public/game/game.js",
        "client/public/game/game.wasm",
        "client/public/game/game.pck",
        "client/public/game/game.audio.worklet.js",
        "client/public/game/game-manifest.json",
        "/manus-storage/*"
      ],
      "phase": "1-10",
      "disposition": "regenerate_and_hash_for_every_runtime_delivery"
    },
    {
      "id": "template_reused_art",
      "mechanism": "Semantic paths resolved by the future template art manifest",
      "consumers": [
        "game/art/template/MANIFEST.json",
        "game/scripts/template/stage_factory.gd"
      ],
      "path_patterns": [
        "client/public/title-video/title-poster-*.jpg",
        "game/art/city/parallax/districts/*_panorama.webp",
        "game/art/city/parallax/infrastructure.png",
        "game/art/city/parallax/near_buildings.png",
        "game/art/robot/grunt/grunt_horizontal_atlas.png",
        "game/art/city/enemies/soldier.png",
        "game/art/city/enemies/tank.png",
        "game/art/city/enemies/helicopter.png",
        "game/art/city/destructibles/debris/*",
        "game/art/presentation/impact_spark.png"
      ],
      "phase": "3-9",
      "disposition": "retain_selected_sources_until_derivative_hashes_and_export_pass"
    },
    {
      "id": "template_audio",
      "mechanism": "Audio streams selected by retained semantic cue mappings",
      "consumers": [
        "game/scenes/main/main.tscn",
        "game/scripts/audio/audio_cue_registry.gd"
      ],
      "path_patterns": [
        "game/audio/music/city_pressure_loop.ogg",
        "game/audio/sfx/robot/*",
        "game/audio/sfx/structural/*",
        "game/audio/sfx/ui/*",
        "game/audio/sfx/upgrades/upgrade_confirm.wav"
      ],
      "phase": "5-9",
      "disposition": "retain_only_cues_reached_by_compact_runtime"
    },
    {
      "id": "user_data",
      "mechanism": "FileAccess, ConfigFile, and atomic tmp/bak persistence under user://",
      "consumers": [
        "game/scripts/audio/audio_volume_settings.gd",
        "game/scripts/input/input_binding_settings.gd",
        "game/scripts/localization/l10n.gd",
        "game/scripts/rampage/player_combat_profile_store.gd",
        "game/scripts/tuning/runtime_tweak_persistence.gd"
      ],
      "path_patterns": [
        "user://audio_volume.cfg",
        "user://input_bindings.cfg",
        "user://localization.cfg",
        "user://player_combat_profile.json*",
        "user://runtime_tweaks.json*",
        "user://template_profile.json*",
        "user://template_tweaks.json*"
      ],
      "phase": "1-8",
      "disposition": "never_delete_during_resource_cleanup"
    }
  ]
}
